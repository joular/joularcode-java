<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.noureddine.joular</groupId>
    <artifactId>joularcodejava</artifactId>
    <version>0.0.1</version>
    <packaging>jar</packaging>
    
    <name>${project.artifactId}</name>
    <description>Joular Code for Java is a lightweight and efficient Java agent for monitoring the energy consumption of methods and execution branches</description>
    <inceptionYear>2026</inceptionYear>
    <url>https://github.com/joular/joularcode-java</url>
    
    <licenses>
        <license>
            <name>The GNU Lesser General Public License v3.0 (LGPL-3.0-only)</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0.en.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Adel Noureddine</name>
            <email>adel.noureddine@outlook.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/joular/joularcode-java.git</connection>
        <developerConnection>scm:git:ssh://github.com:joular/joularcode-java.git</developerConnection>
        <url>https://github.com/joular/joularcode-java</url>
    </scm>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                    <archive>
                        <manifestEntries>
                            <Agent-Class>org.noureddine.joular.joularcodejava.agent.Agent</Agent-Class>
                            <Premain-Class>org.noureddine.joular.joularcodejava.agent.Agent</Premain-Class>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
